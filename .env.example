# Copiar a .env (preferiblemente mediante docker/scripts/Initialize-Env.ps1).
# NO subas el archivo .env a GitHub.
# APP_KEY y JWT_SECRET son valores PRIVADOS y distintos a los del entorno local anterior.
APP_KEY=base64:REEMPLAZAR_CON_BASE64_DE_32_BYTES
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
MYSQL_DATABASE=pcforge
MYSQL_USER=pcforge
MYSQL_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
FRONTEND_PORT=3000
API_PORT=8000
# Opcionales para probar pagos de Stripe (solo sandbox / sk_test_).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
